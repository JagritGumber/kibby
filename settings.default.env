# Kibby settings: everything that differs from one machine or person to the next.
#
# ./install copies this file to ~/.config/kibby/settings.env the first time.
# Change your copy, then run ./install again. Plain KEY=value lines, so the
# shell and systemd units read the file too. Values cannot contain quotes,
# backslashes or {{ }}.

# Apps
KIBBY_BROWSER=firefox

# Display. The output name comes from `hyprctl monitors`; empty matches every
# output. Scale is a number such as 1 or 1.25, or auto.
KIBBY_MONITOR=
KIBBY_MONITOR_SCALE=auto

# Input
# true on laptops with a dedicated numpad, where NumLk otherwise won't stick.
KIBBY_NUMLOCK_BY_DEFAULT=false
# The built-in touchpad's name from `hyprctl devices`. Set it to make the
# laptop's touchpad key lock the touchpad with a toast; empty leaves the key alone.
KIBBY_TOUCHPAD_DEVICE=

# The microphone-mute LED, from `brightnessctl --list`.
KIBBY_MIC_MUTE_LED_DEVICE=platform::micmute

# Wispr Flow glow: how your voice moves the glow.
# Input gain: 0 is automatic. The glow learns your mic's quiet noise and the
# loudest you have spoken in the last second or two, and scales each word
# between them in decibels, so it suits most mics. A number above 0 is a fixed
# gain instead (the old behaviour; 12 suited a quiet headset).
KIBBY_WISPR_INPUT_GAIN=0
# Gate, in dB: how far above your mic's noise a sound must be to move the glow
# (automatic gain only). Lower it if soft words barely move the glow (10 suits
# a quiet headset); raise it if the room or mic is noisy and the glow moves
# when you are silent.
KIBBY_WISPR_GATE_DB=14
# cava's sensitivity for the mic it listens to.
KIBBY_WISPR_CAVA_SENSITIVITY=250
# The bars along the bottom edge while you dictate.
# Look: kurve (rounded bars in Kurve's colours), rainbow, wallpaper (the
# wallpaper's colours) or caelestia (Caelestia's visualiser). This is the look
# until you switch it live with `wispr-glow-style LOOK`, which wins from then on.
KIBBY_WISPR_BAR_STYLE=kurve
# true shows the bars; false keeps only the edge glow.
KIBBY_WISPR_BARS=true
# How many bars across the screen. 0 uses the look's own count (192 for the
# Kurve looks, 150 for caelestia); at most 256.
KIBBY_WISPR_BAR_COUNT=0
# How tall the bars get at full voice, as a share of the screen's height.
KIBBY_WISPR_BAR_MAX_HEIGHT=0.1

# keyd (system files; ./install renders them and prints the sudo commands).
# Device IDs from `sudo keyd monitor`, separated by spaces; each becomes one
# line. * means every keyboard; add -ID entries to leave a device out (for
# example the virtual keyboards of Wispr Flow or ydotool, which must type exact text).
KIBBY_KEYD_KEYBOARD_IDS=*
# A mouse whose side buttons should switch workspaces (m:VENDOR:PRODUCT).
# Empty skips that file.
KIBBY_KEYD_MOUSE_IDS=
