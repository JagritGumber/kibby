{
  "$schema": "https://kibby.dev/schema/config-v1.json",
  "schemaVersion": 1,
  "adapter": "auto",
  "paths": {
    "hyprland": "~/.config/hypr",
    "quickshell": "~/.config/quickshell/kibby"
  },
  "providers": {
    "terminal": "kitty",
    "launcher": "fuzzel",
    "lock": "hyprlock"
  },
  "foundation": {
    "uwsm": "auto",
    "volumeStep": 5,
    "brightnessStep": 5
  },
  "components": []
}
