# The machine Kibby was built on: an ASUS Vivobook 15 with an ELAN touchpad,
# a numpad, a 2.4 GHz keyboard-and-mouse receiver, an HP mouse and an EPOS
# headset (the Wispr settings below are the ones used with that headset).
#
#   ./install --settings examples/vivobook-15.env

KIBBY_BROWSER=helium-browser

KIBBY_MONITOR=
KIBBY_MONITOR_SCALE=1

KIBBY_NUMLOCK_BY_DEFAULT=true
KIBBY_TOUCHPAD_DEVICE=elan1200:00-04f3:30f7-touchpad

KIBBY_MIC_MUTE_LED_DEVICE=platform::micmute

KIBBY_WISPR_INPUT_GAIN=0
KIBBY_WISPR_GATE_DB=14
KIBBY_WISPR_CAVA_SENSITIVITY=250
KIBBY_WISPR_BAR_STYLE=kurve
KIBBY_WISPR_BARS=true
KIBBY_WISPR_BAR_COUNT=0
KIBBY_WISPR_BAR_MAX_HEIGHT=0.1

# Laptop keyboard (AT Translated Set 2) and the receiver's keyboard part.
KIBBY_KEYD_KEYBOARD_IDS=0001:0001:09b4e68d 04f3:026f:dfee5018
# HP mouse and the receiver's mouse part.
KIBBY_KEYD_MOUSE_IDS=m:03f0:0066 04f3:026f:4f51d355
