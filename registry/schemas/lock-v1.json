{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kibby.dev/schema/lock-v1.json",
  "type": "object",
  "required": ["schemaVersion", "foundation", "components"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "foundation": {
      "type": "object",
      "required": ["version", "adapter", "dialect", "manifestHash", "files", "nativeVersions"]
    },
    "components": { "type": "object" }
  },
  "additionalProperties": false
}
