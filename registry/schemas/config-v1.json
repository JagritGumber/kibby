{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kibby.dev/schema/config-v1.json",
  "type": "object",
  "required": ["schemaVersion", "adapter", "paths", "providers", "foundation", "components"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "adapter": { "enum": ["auto", "arch", "cachyos", "generic"] },
    "paths": {
      "type": "object",
      "required": ["hyprland", "quickshell"],
      "properties": {
        "hyprland": { "type": "string" },
        "quickshell": { "type": "string" }
      },
      "additionalProperties": false
    },
    "providers": {
      "type": "object",
      "required": ["terminal", "launcher", "lock"],
      "properties": {
        "terminal": { "const": "kitty" },
        "launcher": { "const": "fuzzel" },
        "lock": { "const": "hyprlock" }
      },
      "additionalProperties": false
    },
    "foundation": {
      "type": "object",
      "required": ["uwsm", "volumeStep", "brightnessStep"],
      "properties": {
        "uwsm": { "enum": ["auto", "always", "never"] },
        "volumeStep": { "type": "integer", "minimum": 1, "maximum": 20 },
        "brightnessStep": { "type": "integer", "minimum": 1, "maximum": 20 }
      },
      "additionalProperties": false
    },
    "components": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
